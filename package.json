{
  "name": "hearth",
  "version": "0.1.0",
  "description": "The fastest resident agent-tool orchestrator: read/write/edit/bash/grep as one warm server",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:napi": "pnpm --filter @hearth/napi build",
    "build:napi:debug": "pnpm --filter @hearth/napi run build:debug",
    "build:rust": "cargo build --release",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:rust": "cargo test --workspace --all-targets",
    "test:napi": "pnpm --filter @hearth/napi test",
    "test:napi:bun": "pnpm --filter @hearth/napi run test:bun",
    "test:pi": "pnpm --filter @hearth/napi run test:pi",
    "test:tarball": "bash scripts/verify-tarball.sh",
    "bench": "cargo bench -p hearth-bench"
  },
  "packageManager": "pnpm@11.5.0"
}
